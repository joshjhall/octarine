target/criterion/

# Added by devcontainer health check
# Environment and OS files
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# FUSE artifacts (bindfs)
.fuse_hidden*

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/memory/tmp/
.claude/worktrees/
.worktrees/

# Python (arch_check tooling)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# pyproject.toml is a pytest shim only; CI installs pytest via pip, so a
# locally-generated poetry.lock is an unused artifact.
poetry.lock

