.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# Coverage
*.profraw
*.profdata
lcov.info
coverage/

# Proptest regressions (keep these - they document found bugs)
